{
  "name": "@marko/vite-plugin-tsrx",
  "version": "0.0.3",
  "description": "Vite plugin for @marko/tsrx (.tsrx modules) targeting Marko 6",
  "keywords": [
    "marko",
    "tsrx",
    "vite"
  ],
  "license": "MIT",
  "author": "LuLaValva",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marko-js/tsrx.git",
    "directory": "packages/vite-plugin-tsrx"
  },
  "homepage": "https://github.com/marko-js/tsrx/tree/main/packages/vite-plugin-tsrx#readme",
  "bugs": {
    "url": "https://github.com/marko-js/tsrx/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@marko/compiler": ">=5.0.0",
    "@marko/tsrx": "^0.0.3",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@marko/compiler": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
