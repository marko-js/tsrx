{
  "name": "@marko/vite-plugin-tsrx",
  "version": "0.0.1",
  "description": "Vite plugin for @marko/tsrx (.tsrx modules) targeting Marko 6",
  "keywords": [
    "marko",
    "tsrx",
    "vite"
  ],
  "license": "MIT",
  "author": "LuLaValva",
