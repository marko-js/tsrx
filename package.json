{
  "name": "marko-tsrx-repo",
  "private": true,
  "description": "Marko TSRX compiler (@marko/tsrx) and Vite plugin (@marko/vite-plugin-tsrx)",
  "license": "MIT",
  "author": "LuLaValva",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "npm run typecheck && tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "change": "changeset",
    "version": "changeset version",
    "publish": "npm run build && changeset publish",
    "@ci:version": "changeset version && pnpm install --lockfile-only",
    "@ci:release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.0",
    "playwright-core": "^1.59.1",
    "prettier": "^3.8.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.0.16"
  }
}
